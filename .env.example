# Optional backend configuration. Copy to .env and uncomment only after
# replacing the placeholders. Defaults work without an .env file.
# PORT=<api-port; development default is documented in README.md>
# HOST=<api-bind-address; development default is documented in README.md>

# Reserved for the later AI service stage; currently unused.
# Keep this key on the server. Never use a WXT_ or VITE_ prefix for secrets.
# SARVAM_API_KEY=<your-server-only-sarvam-key>
