# Optional backend configuration. Copy to .env and uncomment only after
# replacing the placeholders. Defaults work without an .env file, and the
# extension keeps reading, navigating and checking forms with no server at all.
# PORT=<api-port; development default is documented in README.md>
# HOST=<api-bind-address; development default is documented in README.md>

# Server-only secrets. Never use a WXT_ or VITE_ prefix: that would ship them
# to the browser. The extension holds no provider key and no shared credential.
# SARVAM_API_KEY=<your-server-only-sarvam-key>

# Signing secret for expiring pilot credentials, at least 16 characters.
# Without it every /v1 route stays closed and answers service_not_configured.
# Mint one credential per participant:
#   PILOT_TOKEN_SECRET=<secret> node apps/api/dist/pilot-token.js <participant> <hours>
# PILOT_TOKEN_SECRET=<long-random-string>

# Model identifiers, confirmed against Sarvam's API reference on 2026-09-12.
# Change these here rather than in code; live verification is still pending.
# SARVAM_TRANSCRIBE_MODEL=saaras:v3
# SARVAM_INTERPRET_MODEL=sarvam-105b
# SARVAM_SPEECH_MODEL=bulbul:v3
# SARVAM_SPEECH_SPEAKER=shubh

# Limits. Defaults: 4 MiB per recording, 20 s provider timeout, 1 retry,
# 20 requests per credential per minute, per process.
# MAX_AUDIO_BYTES=4194304
# PROVIDER_TIMEOUT_MS=20000
# PROVIDER_RETRIES=1
# RATE_LIMIT_PER_MINUTE=20

# Point the provider adapter elsewhere, e.g. at a mock during testing.
# SARVAM_BASE_URL=https://api.sarvam.ai
